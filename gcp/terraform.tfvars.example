project_id = "your-gcp-project-id"

ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... your-key"

# --- Build phase (CPU, cheap) ---
# e2-standard-4: 4 vCPU, 16 GiB, ~$0.12/hr on-demand
machine_type = "e2-standard-4"
spot         = false

# --- GPU phase (override these) ---
# n1-standard-4 + T4: 4 vCPU, 15 GiB, ~$0.35/hr on-demand / ~$0.11/hr preemptible
# machine_type = "n1-standard-4"
# gpu_type     = "nvidia-tesla-t4"
# gpu_count    = 1
# spot         = true

# --- Clone phase (override these) ---
# source_image = "projects/your-project/global/images/faig-build-20260101"
# vm_count     = 3
# disk_type    = "pd-ssd"
