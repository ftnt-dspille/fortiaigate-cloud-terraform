---
# RuntimeClass that maps to the `nvidia` containerd runtime registered by the
# NVIDIA Container Toolkit. Pods that set `runtimeClassName: nvidia` are
# launched via nvidia-container-runtime, which injects the userspace driver
# libraries and device nodes into the container.
#
# The handler value MUST match the runtime name in containerd's config.toml:
#   [plugins."io.containerd.grpc.v1.cri".containerd.runtimes."nvidia"]
# k3s registers this name automatically when the toolkit is present.
apiVersion: node.k8s.io/v1
kind: RuntimeClass
metadata:
  name: nvidia
handler: nvidia
