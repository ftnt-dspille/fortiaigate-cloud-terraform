apiVersion: v1
kind: Secret
type: Opaque
metadata:
  name: {{ chatbot_release_name }}-secrets
  namespace: {{ chatbot_namespace }}
stringData:
  LLM_API_KEY: {{ chatbot_llm_api_key | default('', true) | string }}
  BEDROCK_KNOWLEDGE_BASE_ID: {{ chatbot_bedrock_kb_id | default('', true) | string }}
  BEDROCK_MODEL_ID: {{ chatbot_bedrock_model_id | default('', true) | string }}
